# Copie para tools/.env.local (fora do Git) e preencha só o que quiser sobrescrever.
# Sem este arquivo, os scripts usam api/local.settings.json.

# Modelo de texto (descrições das poses)
# FOUNDRY_ENDPOINT=https://treinoai-foundry.openai.azure.com
# FOUNDRY_API_KEY=
# FOUNDRY_DEPLOYMENT=gpt-6-luna

# Modelo de imagem; se omitido, usa o mesmo endpoint e chave do texto
# FOUNDRY_IMAGE_ENDPOINT=
# FOUNDRY_IMAGE_API_KEY=
# FOUNDRY_IMAGE_DEPLOYMENT=gpt-image-2.5
